---
source: crates/aldente-cli/tests/commands.rs
expression: "env.text(&[\"graph\", \"--level\", \"unit\", \"--format\", \"graphml\"])"
---
<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns">
  <key id="name" for="node" attr.name="name" attr.type="string"/>
  <key id="nkind" for="node" attr.name="kind" attr.type="string"/>
  <key id="ekind" for="edge" attr.name="kind" attr.type="string"/>
  <key id="certainty" for="edge" attr.name="certainty" attr.type="string"/>
  <key id="reason" for="edge" attr.name="reason" attr.type="string"/>
  <key id="count" for="edge" attr.name="count" attr.type="long"/>
  <graph id="aldente" edgedefault="directed">
    <node id="unit:libs/common"><data key="name">libs/common</data><data key="nkind">unit</data></node>
    <node id="unit:services/billing"><data key="name">services/billing</data><data key="nkind">unit</data></node>
    <node id="unit:services/orders"><data key="name">services/orders</data><data key="nkind">unit</data></node>
    <edge source="unit:services/orders" target="unit:libs/common"><data key="ekind">calls</data><data key="certainty">certain</data><data key="reason">direct</data><data key="count">2</data></edge>
    <edge source="unit:services/orders" target="unit:libs/common"><data key="ekind">depends</data></edge>
  </graph>
</graphml>
